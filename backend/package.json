{
  "name": "sbts-backend",
  "version": "1.0.0",
  "description": "SBTS - Smart Bus Transport System Backend API",
  "main": "index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "demo": "ts-node-dev --respawn --transpile-only -r dotenv/config src/server.ts -- dotenv_config_path=.env.demo",
    "build": "tsc",
    "start": "node dist/backend/src/server.js",
    "start:demo": "node -r dotenv/config dist/backend/src/server.js -- dotenv_config_path=.env.demo",
    "seed": "ts-node src/seed.ts",
    "seed-demo": "ts-node src/seed-demo.ts",
    "seed-demo:prod": "node dist/backend/src/seed-demo.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.0",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "firebase-admin": "14.4.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "9.2.3",
    "multer": "^2.1.1",
    "nodemailer": "10.0.10",
    "puppeteer": "25.11.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.1.0",
    "@types/node": "^25.9.1",
    "@types/nodemailer": "^8.0.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^6.0.3"
  }
}
