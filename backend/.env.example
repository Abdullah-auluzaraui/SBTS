# Server Configuration
PORT=5000

# Database Configuration
# For local development: mongodb://localhost:27017/SBMS
# For MongoDB Atlas: mongodb+srv://<username>:<password>@cluster0.mongodb.net/SBMS
MONGO_URI=your_mongodb_uri_here

# Security Configuration
JWT_SECRET=
JWT_EXPIRE=24h

# Encryption Configuration
# Must be 32 characters or 64 hex characters
ENCRYPTION_KEY=

# Generate each key separately using crypto.randomBytes(32).toString("hex")
DEMO_MODE=false
SUPERADMIN_USERNAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
